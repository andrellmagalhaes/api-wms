# Descomente e preencha a opção do banco de dados que deseja utilizar:

# Opção 1: SQLite (Ideal para testes locais rápidos)
# DATABASE_URL=sqlite:///./banco_local.db

# Opção 2: PostgreSQL
# DATABASE_URL=postgresql://usuario:senha@localhost:5432/meubanco

# Opção 3: MySQL
# DATABASE_URL=mysql+pymysql://usuario:senha@localhost:3306/meubanco
